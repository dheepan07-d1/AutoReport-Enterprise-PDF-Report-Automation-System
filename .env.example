# AutoReport Environment Configuration
# Copy this file to .env and adjust values as needed. Never commit .env to version control.

# REST API Settings (Open-Meteo requires no API key)
AUTOREPORT_API_BASE_URL=https://api.open-meteo.com/v1/forecast
AUTOREPORT_REQUEST_TIMEOUT=15

# Default Location Settings (Coimbatore, India)
AUTOREPORT_DEFAULT_LATITUDE=11.0168
AUTOREPORT_DEFAULT_LONGITUDE=76.9558
AUTOREPORT_DEFAULT_LOCATION_NAME=Coimbatore, IN
AUTOREPORT_FORECAST_DAYS=7
AUTOREPORT_TIMEZONE=auto

# Logging Settings
AUTOREPORT_LOG_LEVEL=INFO

# Scheduler Settings
AUTOREPORT_SCHEDULE_INTERVAL=daily
AUTOREPORT_SCHEDULE_TIME=08:00
AUTOREPORT_SCHEDULE_INTERVAL_MINUTES=60
